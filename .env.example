# NVIDIA_API_KEY: Required for the AI Tutor / Quiz / Summary endpoints.
# Get a key from https://build.nvidia.com (integrate.api.nvidia.com).
# Set this as a real environment variable / secret — never commit an actual key.
NVIDIA_API_KEY="MY_NVIDIA_API_KEY"

# NVIDIA_MODEL: Optional override for which hosted model to use.
NVIDIA_MODEL="moonshotai/kimi-k3"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
